shader_type spatial;
render_mode cull_back, diffuse_burley, specular_schlick_ggx;

// Original compile-stress shader for Better Tooltips cache testing.
// Medium stress level; smooth layered ice appearance.
// Most stress work is deliberately placed in the vertex stage: this creates
// a large shader AST/pipeline without making every preview pixel unnecessarily expensive.
// Increment CACHE_BUSTER before a cold-compile test to force a new shader variant
// without clearing the global GPU-driver shader cache.
const float CACHE_BUSTER = 1.000102;
varying float compile_signal;
varying vec3 object_pos;

