void vertex() {
	object_pos = VERTEX;
	float seed = dot(VERTEX, vec3(0.371, 0.529, 0.713)) * CACHE_BUSTER + 0.230000;
	compile_signal = compile_stress(seed);
	VERTEX += NORMAL * ((compile_signal - 0.5) * 0.0025);
}

void fragment() {
	vec3 p = normalize(object_pos);
	float layer_a = 0.5 + 0.5 * sin(p.y * 11.0 + p.x * 3.0 + p.z * 2.2);
	float layer_b = 0.5 + 0.5 * sin(p.y * 18.0 - p.x * 2.1 + p.z * 4.0 + 1.1);
	float body = smoothstep(0.20, 0.84, layer_a * 0.64 + layer_b * 0.36);
	float frost = pow(body, 4.0);
	vec3 deep = vec3(0.018, 0.085, 0.15);
	vec3 blue = vec3(0.10, 0.52, 0.76);
	vec3 pale = vec3(0.68, 0.91, 0.98);
	vec3 color = mix(deep, blue, body);
	color = mix(color, pale, frost * 0.32);
	color += vec3((compile_signal - 0.5) * 0.010);
	ALBEDO = clamp(color, vec3(0.0), vec3(1.0));
	EMISSION = vec3(0.004, 0.020, 0.038) * body;
	METALLIC = 0.05;
	ROUGHNESS = mix(0.24, 0.46, 1.0 - body);
}
