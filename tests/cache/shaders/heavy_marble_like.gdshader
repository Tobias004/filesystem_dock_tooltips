	v = fract(v + v * v * 0.492400 + 0.576809);
	v = mix(v, fract(v * 1.008840 + 0.629336), 0.330000);
	v = fract(v * 1.009210 + 0.681863);
	v = abs(v * 2.0 - 1.0) * 0.501100 + v * 0.498900;
	v = fract(v + v * v * 0.470300 + 0.786918);
	v = mix(v, fract(v * 1.010320 + 0.839445), 0.370000);
	v = fract(v * 1.000720 + 0.891972);
	v = abs(v * 2.0 - 1.0) * 0.479000 + v * 0.521000;
	v = fract(v + v * v * 0.481900 + 0.997027);
	v = mix(v, fract(v * 1.001830 + 0.049554), 0.410000);
	v = fract(v * 1.002200 + 0.102081);
	v = abs(v * 2.0 - 1.0) * 0.490600 + v * 0.509400;
	v = fract(v + v * v * 0.493500 + 0.207136);
	v = mix(v, fract(v * 1.003310 + 0.259663), 0.450000);
	v = fract(v * 1.003680 + 0.312190);
	v = abs(v * 2.0 - 1.0) * 0.502200 + v * 0.497800;
	v = fract(v + v * v * 0.471400 + 0.417245);
	v = mix(v, fract(v * 1.004790 + 0.469772), 0.490000);
	v = fract(v * 1.005160 + 0.522299);
	v = abs(v * 2.0 - 1.0) * 0.480100 + v * 0.519900;
	v = fract(v + v * v * 0.483000 + 0.627354);
	v = mix(v, fract(v * 1.006270 + 0.679881), 0.360000);
	v = fract(v * 1.006640 + 0.732408);
	v = abs(v * 2.0 - 1.0) * 0.491700 + v * 0.508300;
	v = fract(v + v * v * 0.494600 + 0.837463);
	v = mix(v, fract(v * 1.007750 + 0.889990), 0.400000);
	v = fract(v * 1.008120 + 0.942517);
	v = abs(v * 2.0 - 1.0) * 0.503300 + v * 0.496700;
	v = fract(v + v * v * 0.472500 + 0.047572);
	v = mix(v, fract(v * 1.009230 + 0.100099), 0.440000);
	v = fract(v * 1.009600 + 0.152626);
	v = abs(v * 2.0 - 1.0) * 0.481200 + v * 0.518800;
	v = fract(v + v * v * 0.484100 + 0.257681);
	v = mix(v, fract(v * 1.000740 + 0.310208), 0.480000);
	return v;
}

void vertex() {
	object_pos = VERTEX;
	float seed = dot(VERTEX, vec3(0.371, 0.529, 0.713)) * CACHE_BUSTER + 0.256000;
	compile_signal = compile_stress(seed);
	VERTEX += NORMAL * ((compile_signal - 0.5) * 0.0025);
}

void fragment() {
	vec3 p = normalize(object_pos);
	float warp = sin(p.x * 5.5 + p.z * 4.0) * 0.22 + sin(p.y * 9.0 - p.z * 2.0) * 0.12;
	float vein_wave = sin((p.y * 8.0 + p.x * 2.4 + warp) * 3.14159265);
	float vein = 1.0 - smoothstep(0.02, 0.20, abs(vein_wave));
	float fine_wave = sin((p.y * 19.0 - p.x * 3.0 + p.z * 2.0) * 3.14159265);
	float fine = (1.0 - smoothstep(0.0, 0.12, abs(fine_wave))) * 0.35;
	float veins = clamp(vein + fine, 0.0, 1.0);
	vec3 stone = vec3(0.82, 0.84, 0.86);
	vec3 light_stone = vec3(0.96, 0.97, 0.98);
	vec3 dark_vein = vec3(0.16, 0.19, 0.22);
	float lift = 0.5 + 0.5 * p.y;
	vec3 color = mix(stone, light_stone, lift * 0.34);
	color = mix(color, dark_vein, veins * 0.72);
	color += vec3((compile_signal - 0.5) * 0.006);
	ALBEDO = clamp(color, vec3(0.0), vec3(1.0));
	METALLIC = 0.02;
	ROUGHNESS = mix(0.30, 0.48, veins);
}
