[node name="chkbCodeEditorDoc" type="CheckBox" parent="MarginContainer/Columns/DocumentationColumn" unique_id=194112211]
layout_mode = 2
tooltip_text = "Extends Godot Code Editor symbol help and ScriptEditor
navigation controls with project GDScript documentation. This
includes the stock script list plus compatible tabs/outlines
from Quill IDE and Script-IDE."
button_pressed = true
text = "Code editor & script navigation docs"

[node name="CodeEditorOptionsIndent" type="MarginContainer" parent="MarginContainer/Columns/DocumentationColumn" unique_id=1159159554]
layout_mode = 2
