theme_override_constants/separation = 2

[node name="chkbDocumentationComments" type="CheckBox" parent="MarginContainer/Columns/DocumentationColumn/CodeEditorOptionsIndent/CodeEditorOptions" unique_id=152727525]
layout_mode = 2
tooltip_text = "Shows Godot-style ## documentation comments with the add-on
renderer for supported project classes and members in code and
ScriptEditor navigation tooltips. This preserves source line
breaks and avoids the clipping behavior of Godot's compact
native project documentation tooltip."
button_pressed = true
text = "Show ## documentation comments"

[node name="chkbSingleHashDoc" type="CheckBox" parent="MarginContainer/Columns/DocumentationColumn/CodeEditorOptionsIndent/CodeEditorOptions" unique_id=540211061]
layout_mode = 2
tooltip_text = "Treats an ordinary contiguous # comment block directly above a
supported project class/member as tooltip documentation in code
and ScriptEditor navigation tooltips. This is an add-on
extension for implementation-specific notes that should not
become Godot API documentation."
button_pressed = true
text = "Show single # comment blocks"

[node name="chkbReplaceGodotMemberDocs" type="CheckBox" parent="MarginContainer/Columns/DocumentationColumn/CodeEditorOptionsIndent/CodeEditorOptions" unique_id=1965630620]
layout_mode = 2
tooltip_text = "When Godot's native tooltip is showing the same project ##
documentation, hide that duplicate description and render it
with the add-on instead. Godot's own engine/API documentation
and distinct inherited help remain untouched."
button_pressed = true
text = "Replace Godot-rendered project docs"

[node name="chkbQuillIntegration" type="CheckBox" parent="MarginContainer/Columns/DocumentationColumn/CodeEditorOptionsIndent/CodeEditorOptions" unique_id=57867918]
layout_mode = 2
tooltip_text = "Searches for Quill IDE script tabs and outline controls and adds
the same project documentation tooltips there. Disable this
compatibility integration if a future Quill version changes its
editor controls or causes problems; standard Godot code and
script-list tooltips remain enabled."
button_pressed = true
text = "Enable Quill IDE integration"

[node name="chkbScriptIdeIntegration" type="CheckBox" parent="MarginContainer/Columns/DocumentationColumn/CodeEditorOptionsIndent/CodeEditorOptions" unique_id=940639737]
layout_mode = 2
tooltip_text = "Searches for Script-IDE script tabs and outline controls and
adds the same project documentation tooltips there. Disable this
compatibility integration if a future Script-IDE version changes
its editor controls or causes problems; standard Godot code and
script-list tooltips remain enabled."
button_pressed = true
text = "Enable Script-IDE integration"

